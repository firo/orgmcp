{
  "name": "orgmcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for Salesforce orgs, with browser login delegated to the Salesforce CLI",
  "private": true,
  "type": "module",
  "bin": {
    "orgmcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node test/unit.mjs && node test/tools.mjs && node test/timeout.mjs && node test/e2e.mjs && node test/redacted.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@salesforce/core": "^9.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firo/orgmcp.git"
  }
}
